# fleett control plane — read by systemd (EnvironmentFile=/etc/fleett/fleett.env).
#
# This file is a dpkg conffile: local edits survive package upgrades.
# Format: KEY=VALUE, no shell expansion, no quoting, one setting per line.
#
# The service refuses to start while FLEETT_TOKEN is empty.

# Data root: instances, shares, backups and the SQLite index.
FLEETT_ROOT=/var/lib/fleett

# Loopback only. Put an authenticated reverse proxy (Caddy + Authentik, SSH
# tunnel) in front before exposing it.
FLEETT_BIND=127.0.0.1:8090

# compose = real Docker; mock = in-memory, for a UI smoke test only.
FLEETT_DRIVER=compose

# REQUIRED. Long random bearer token, generate one with:
#   openssl rand -hex 32
FLEETT_TOKEN=

# --- optional overrides -----------------------------------------------------
# Agent image built once on this host (see docs/DEPLOY.md).
#FLEETT_IMAGE=hermes-agent:0.22.2-local
# Docker network shared by the agent containers.
#FLEETT_NETWORK=fleett
# restrict (default) requires a fresh `fleett egress install` marker before an
# instance can be created on the restricted network; off skips the check.
#FLEETT_EGRESS=restrict
# AES-256 key encrypting instance secrets; created by the package (0640).
#FLEETT_SECRETS_KEY_FILE=/etc/fleett/secrets.key
# Fleet-wide caps, 0 disables them.
#FLEETT_MAX_TOTAL_CPU=4
#FLEETT_MAX_TOTAL_MEM_MB=8192
