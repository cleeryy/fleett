    {
      "id": 8,
      "type": "stat",
      "title": "Fleet memory pressure",
      "description": "Memory used by all instance containers, as a percentage of their limits.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
