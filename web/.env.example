# Dev defaults to the in-memory mock adapter (every API.md endpoint, seeded).
# Set to 0 to call the Rust controller through the Vite proxy (/api -> 127.0.0.1:8090).
VITE_MOCK=1

# Only needed when the API is not same-origin and not behind the Vite proxy.
# VITE_API_BASE=http://127.0.0.1:8090

# Mock only. Set to 0 to simulate a host without `fleett egress install`:
# creating a restricted instance (allow_lan=false) then returns the real
# 409 `egress_not_enforced` so the remediation path can be checked.
# VITE_MOCK_EGRESS_ENFORCED=0

# Mock only. Set to 0 to simulate a host without `fleett secrets init`:
# storing a provider token returns the real 409 `secrets_key_missing` so the
# remediation path can be checked.
# VITE_MOCK_SECRETS_KEY=0

# Mock only. Which login methods the mock console advertises:
# bearer (default), oidc, or both. With oidc/both, "Sign in with Authentik"
# opens a demo admin session so the UI works without a backend.
# VITE_MOCK_AUTH=bearer

# Mock only. Live log transport: live (default), poll (the SSE stream fails
# and the console polls every second), or down (both endpoints fail).
# `?mock_logs=` overrides it, and the Logs tab has a mock-only switch.
# VITE_MOCK_LOG_TRANSPORT=live
